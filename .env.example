# Copy to .env (gitignored) and fill in. Never commit real keys.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# low | medium | high  (reasoning budget for gpt-oss models; leave empty to omit)
LLM_REASONING_EFFORT=low
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Business policy / reliability (deterministic, never decided by the LLM)
# APPROVAL_THRESHOLD=200000   # amounts strictly above this need human approval
# MAX_RETRIES=3               # AP rejections tolerated before the task fails

# MOCK_APP_URL=http://127.0.0.1:5000
